<!-- SCIPIO: 4.0.0: MCP permissions for the demo admin group. FULLADMIN is demo data (SecurityGroupDemoData.xml), so
     these grants cannot live in the seed file: on a fresh database the seed load comes first, the insert breaks the
     group foreign key, and the whole seed file rolls back. -->
<entity-engine-xml>
    <SecurityGroupPermission groupId="FULLADMIN" permissionId="MCP_ACCESS"/>
    <SecurityGroupPermission groupId="FULLADMIN" permissionId="MCP_GATEWAY"/>
    <SecurityGroupPermission groupId="FULLADMIN" permissionId="MCP_ENTITY_READ"/>
    <SecurityGroupPermission groupId="FULLADMIN" permissionId="MCP_ENTITY_WRITE"/>
    <SecurityGroupPermission groupId="FULLADMIN" permissionId="MCP_ADMIN"/>
    <SecurityGroupPermission groupId="FULLADMIN" permissionId="MCP_CODE_WRITE"/>
    <SecurityGroupPermission groupId="FULLADMIN" permissionId="MCP_MAIL_SEND"/>
</entity-engine-xml>
