    ["Creative Commons Attribution-NonCommercial 4.0", "CC-BY-NC"],
    ["Creative Commons 3.0 BY-SA", "CC-BY-SA-3.0"],
    ["Boost Software License 1.0", "BSL-1.0"],
    ["SIL Open Font License 1.1", "OFL-1.1"],
    ["Public Domain", "LicenseRef-Public-Domain"],
    ["Unicode/ICU License", "Unicode-3.0"],
    ["(MIT-style) netCDF C library license", "NetCDF"]
  ],

  "_declared": "Licenses that the metadata of a module does not give, or gives wrong. The key is group:name, or group:name:version for one version. A value replaces the licenses from the metadata. A list means a choice (OR); in one entry, AND means that the licenses apply together.",
  "declared": {
    "relaxngDatatype:relaxngDatatype": { "licenses": ["BSD-3-Clause"], "source": "RELAX NG datatype library copying.txt (BSD, Thai Open Source Software Center and James Clark)" },
    "dom4j:dom4j:1.6.1": { "licenses": ["Plexus"], "source": "dom4j 1.6.1 LICENSE.txt: BSD style with name clauses (as dom4j 2.1.4); the Solr webapp jar" },
    "xalan:serializer": { "licenses": ["Apache-2.0"], "source": "Apache Xalan-J 2.7.3, LICENSE.txt of the distribution" },
    "xml-apis:xml-apis": { "licenses": ["Apache-2.0 AND W3C AND LicenseRef-Public-Domain"], "source": "xml-commons external 1.0.b2 (xml-apis 2.0.2 relocates to it): Apache-2.0 with the W3C DOM and the public-domain SAX" },
    "org.apache.derby:derby:10.14.2.0": { "licenses": ["Apache-2.0"], "source": "the CDDL entry comes from META-INF/NOTICE (the Derby distribution); the jar holds Apache-2.0 code" },
    "org.apache.derby:derbytools:10.14.2.0": { "licenses": ["Apache-2.0"], "source": "the CDDL entry comes from META-INF/NOTICE (the Derby distribution); the jar holds Apache-2.0 code" },
    "org.apache.solr:solr-solrj:7.5.0": { "licenses": ["Apache-2.0"], "source": "the CDDL entries come from META-INF/NOTICE.txt (the Solr distribution); the jar holds Apache-2.0 code" },
    "org.apache.tomcat:tomcat-servlet-api": { "licenses": ["Apache-2.0 AND CDDL-1.0"], "source": "Tomcat LICENSE: the Java EE deployment descriptor schemas in the jar are CDDL-1.0" }
  },

  "_jars": "Committed jars that carry no usable license data. The key is a Java regex on the path from the root of this repository, with forward slashes.",
  "jars": [
    { "path": "^framework/base/lib/ant/ant-contrib-1[.]0b3[.]jar$", "licenses": ["Apache-1.1"], "source": "ant-contrib 1.0b3, docs/LICENSE.txt of the distribution (Apache Software License 1.1)" },
    { "path": "^ivy/localRepo/org[.]restlet[.]jee/", "licenses": ["Apache-2.0 OR LGPL-3.0 OR LGPL-2.1 OR CDDL-1.0 OR EPL-1.0"], "source": "org.restlet.parent-2.3.0.pom (maven.restlet.talend.com)" }
  ],

  "_web": "Third-party JavaScript and CSS libraries without usable license data. The key is a Java regex on the folder of the library (or the path of a single file) from the root of this repository. webFirstParty lists folders with an own package.json or bower.json that are not libraries.",
  "webOwn": ["^themes/ignite-admin/webapp/ignite/dist/js/all[.]min[.]js$"],
  "web": [
    { "path": "^applications/solr/webapp/libs/jquery-(1[.]7[.]2|2[.]1[.]3)[.]min[.]js$", "licenses": ["MIT"], "source": "jQuery (the file name gives the version): MIT" },
    { "path": "^applications/solr/webapp/libs/jquery-ui[.]min[.]js$", "licenses": ["MIT"], "source": "jQuery UI: MIT" },
    { "path": "^framework/images/webapp/images/jsgantt[.](js|css)$", "licenses": ["MIT"], "source": "jsGanttImproved 1.8.0 (github.com/jsGanttImproved/jsgantt-improved): MIT; lane A confirms the text in L-05" },
    { "path": "^framework/common/webapp/common/dist/libs/@hotwired/turbo$", "licenses": ["MIT"], "source": "@hotwired/turbo 8.0.23 (package.json of the npm package): MIT; the dist header names no license" },
    { "path": "^framework/images/webapp/images/imagemanagement/sizzle[.]min[.]js$", "licenses": ["MIT"], "source": "Sizzle (jQuery Foundation): MIT" },
    { "path": "^themes/aurora/webapp/aurora/css/vendor/flatpickr[.]min[.]css$", "licenses": ["MIT"], "source": "flatpickr: MIT (the same theme ships flatpickr.min.js)" },
    { "path": "^themes/base/webapp/base/bower_components/rainbow$", "licenses": ["Apache-2.0"], "source": "Rainbow (Craig Campbell): Apache-2.0" },
    { "path": "^themes/base/webapp/base/js/freetile[.]min[.]js$", "licenses": ["MIT"], "source": "Freetile 0.3.1 (github.com/yconst/Freetile): MIT" },
    { "path": "jquery[.]dataTables[.]min[.]css$", "licenses": ["MIT"], "source": "DataTables: MIT" },
    { "path": "^themes/ignite-admin/webapp/ignite/dist/js/coreui(-utilities)?[.]min[.]js$", "licenses": ["MIT"], "source": "CoreUI Free 2.x (coreui.io/license): MIT" },
    { "path": "^themes/ignite-admin/webapp/ignite/dist/libs/jquery$", "licenses": ["MIT"], "source": "jQuery 3.x: MIT" },
    { "path": "^themes/ignite-admin/webapp/ignite/dist/libs/moment$", "licenses": ["MIT"], "source": "Moment.js: MIT" },
    { "path": "^themes/ignite-admin/webapp/ignite/dist/libs/pace$", "licenses": ["MIT"], "source": "PACE (HubSpot): MIT" },
    { "path": "^themes/ignite-admin/webapp/ignite/dist/libs/simple-line-icons$", "licenses": ["MIT"], "source": "Simple Line Icons: MIT" },
    { "path": "^themes/ignite-admin/webapp/ignite/dist/libs/tether$", "licenses": ["MIT"], "source": "Tether: MIT" },
    { "path": "^themes/ignite-(admin|shop)/webapp/ignite/rtl/bootstrap[.]rtl[.]min[.]css$", "licenses": ["MIT"], "source": "Bootstrap 4 RTL overrides: MIT" }
  ],
  "webFirstParty": ["^themes/[^/]+/webapp/[^/]+$", "^framework/common/webapp/common$"],

  "_exceptions": "Blocked dependencies that the check lets through until lane A decides. The key is group:name, group:name:version, or the path of a committed jar. Remove an entry when its dependency goes.",
  "exceptions": {}
}
