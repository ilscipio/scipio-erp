    <RecurrenceRule recurrenceRuleId="CMS_DEMO_RESET" frequency="HOURLY" intervalNumber="1" countNumber="-1" untilDateTime=""/>
    <RecurrenceInfo recurrenceInfoId="CMS_DEMO_RESET" startDateTime="2026-01-01 00:00:00.000" recurrenceRuleId="CMS_DEMO_RESET" recurrenceCount="0"/>
    <JobSandbox jobId="CMS_DEMO_RESET" jobName="CMS demo reset (public demo only)" runTime="2026-01-01 00:00:00.000" serviceName="cmsDemoReset"
        poolId="pool" runAsUser="system" recurrenceInfoId="CMS_DEMO_RESET" maxRecurrenceCount="-1" statusId="SERVICE_PENDING"/>
</entity-engine-xml>
