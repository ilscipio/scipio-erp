<!-- SCIPIO: 4.0.0: Hosted profile (W1-02): security groups of a store and of our operators. See docs/wp/W1-02.md.
     Rule: no TENANT_* group gets FULLADMIN, a WEBTOOLS permission, MCP_CODE_WRITE, MCP_ENTITY_WRITE, MCP_ENTITY_READ, MCP_ADMIN,
     CMS_CODE_* or HOSTED_OPS. The unit test HostedSeedDataTest checks this file. -->
<entity-engine-xml>
    <SecurityPermission permissionId="CMS_CODE_VIEW" description="View the code of CMS templates, scripts and assets (hosted profile: operators only)."/>
    <SecurityPermission permissionId="CMS_CODE_UPDATE" description="Write the code of CMS templates, scripts and assets, and import CMS data (hosted profile: operators only). The content permissions are CMS_VIEW, CMS_CREATE, CMS_UPDATE and CMS_DELETE."/>
    <SecurityPermission permissionId="HOSTED_OPS" description="Run code and file services in a hosted store. Only the SCIPIO_OPS group holds it."/>

    <SecurityGroup groupId="TENANT_OWNER" description="Owner of a hosted store: the whole store, no code and no server access."/>
    <SecurityGroupPermission groupId="TENANT_OWNER" permissionId="MCP_ACCESS"/>
    <SecurityGroupPermission groupId="TENANT_OWNER" permissionId="MCP_GATEWAY"/>
    <SecurityGroupPermission groupId="TENANT_OWNER" permissionId="MCP_MAIL_SEND"/>
