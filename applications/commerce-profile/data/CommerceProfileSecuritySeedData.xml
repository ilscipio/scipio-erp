    <SecurityGroupPermission groupId="SCIPIO_OPS" permissionId="HOSTED_OPS"/>
    <SecurityGroupPermission groupId="SCIPIO_OPS" permissionId="CMS_CODE_VIEW"/>
    <SecurityGroupPermission groupId="SCIPIO_OPS" permissionId="CMS_CODE_UPDATE"/>
