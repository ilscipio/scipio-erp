<screens xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/widget-screen.xsd">

    <!-- SCIPIO: 4.0.0: Screen definitions are Java annotations in
        src/.../widget/ComplianceScreens.java. This file retains only the
        screen-settings blocks, which are an XML-only feature. -->

    <!-- SCIPIO: Common settings for other *Screens.xml files in this app (those that primarily use decorators referenced using parameters.mainDecoratorLocation) -->
    <screen-settings name="common-settings">
        <decorator-screen-settings default-fallback-location="component://compliance/widget/CommonScreens.xml"/>
    </screen-settings>

    <!-- SCIPIO: The settings for this file (active). -->
    <screen-settings name="local-settings">
        <auto-include-settings>
            <include-settings as-name="local-settings" name="common-settings" location="component://compliance/widget/CommonScreens.xml"/>
        </auto-include-settings>
    </screen-settings>

</screens>
