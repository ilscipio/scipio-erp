{
  "_about": "The license policy of the build task checkLicensePolicy. The prose and the reasons are in docs/licenses/policy.md. Keep the two files in step.",

  "allowed": [
    "Apache-2.0", "MIT", "MIT-0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "0BSD", "Zlib", "BSL-1.0", "Unlicense",
    "CC0-1.0", "LicenseRef-Public-Domain", "WTFPL", "Unicode-3.0", "W3C", "PostgreSQL", "UPL-1.0", "NetCDF",
    "OGC-1.0", "LicenseRef-Ilscipio-Proprietary"
  ],
  "review": [
    "CDDL-1.0", "CDDL-1.1", "EPL-1.0", "EPL-2.0", "CPL-1.0", "LGPL-2.1", "LGPL-3.0", "LGPL", "MPL-1.1", "MPL-2.0",
    "GPL-2.0-only WITH Classpath-exception-2.0", "Apache-1.1", "xpp", "LicenseRef-JDOM", "Plexus",
    "BSD-3-Clause-No-Nuclear-Warranty", "CC-BY", "CC-BY-2.5", "CC-BY-3.0", "CC-BY-4.0", "CC-BY-SA-3.0", "CC-BY-SA-4.0", "OFL-1.1"
  ],
  "blocked": [
    "GPL-2.0-only", "GPL-3.0-only", "GPL", "AGPL-3.0-only", "SSPL-1.0", "BUSL-1.1", "LicenseRef-Commons-Clause",
    "JSON", "LicenseRef-UnRAR", "CC-BY-NC", "LicenseRef-Unknown"
  ],

  "_closedOnly": "Licenses that only the closed layer may use. In a core scope (core module or core jar) they are blocked: the core never depends on a closed part (blueprint 3.3).",
  "closedOnly": ["LicenseRef-Ilscipio-Proprietary"],

  "_aliases": "The raw license names and URLs from the POMs, the manifests and the license files, mapped to one id. The task tries the name first, then the URL. The first pattern that matches wins, so the order is important. A pattern is a Java regex, case-insensitive, found anywhere in the text.",
  "aliases": [
    { "id": "CDDL-1.1", "patterns": ["dual license.*cddl", "cddl ?[+] ?gpl"] },
    { "id": "GPL-2.0-only WITH Classpath-exception-2.0", "patterns": ["classpath", "gplv2[+]ce", "[+]ce[.]html", "w/ ?cpe"] },
    { "id": "LicenseRef-Commons-Clause", "patterns": ["commons clause"] },
    { "id": "SSPL-1.0", "patterns": ["server side public", "[^a-z]sspl"] },
    { "id": "BUSL-1.1", "patterns": ["business source", "[^a-z]busl"] },
    { "id": "JSON", "patterns": ["json license", "json[.]org/license"] },
    { "id": "LicenseRef-UnRAR", "patterns": ["unrar"] },
    { "id": "CC-BY-NC", "patterns": ["noncommercial", "non-commercial", "by-nc"] },
    { "id": "AGPL-3.0-only", "patterns": ["affero", "(^|[^a-z])agpl"] },
    { "id": "LGPL-3.0", "patterns": ["lesser.*3", "library general.*3", "lgpl.?v?3"] },
    { "id": "LGPL-2.1", "patterns": ["lesser.*2", "library general.*2", "lgpl.?v?2"] },
    { "id": "LGPL", "patterns": ["lesser general public", "library general public", "(^|[^a-z])lgpl"] },
    { "id": "GPL-3.0-only", "patterns": ["general public.*3", "(^|[^a-z])gpl.?v?3", "licenses/gpl-3"] },
    { "id": "GPL-2.0-only", "patterns": ["general public.*[^0-9.]2([^0-9]|$)", "(^|[^a-z])gpl.?v?2", "licenses/old-licenses/gpl-2"] },
    { "id": "GPL", "patterns": ["general public", "(^|[^a-z])gpl([^a-z]|$)", "gnu[.]org/licenses/gpl"] },
    { "id": "CDDL-1.1", "patterns": ["cddl.*1[.]1", "development and distribution.*1[.]1"] },
    { "id": "CDDL-1.0", "patterns": ["common development and distribution", "cddl"] },
    { "id": "BSD-3-Clause", "patterns": ["eclipse distribution", "(^|[^a-z])edl", "edl-v10"] },
    { "id": "EPL-2.0", "patterns": ["eclipse public.*2", "(^|[^a-z])epl.?v?2", "epl-v20", "epl-2"] },
    { "id": "EPL-1.0", "patterns": ["eclipse public", "(^|[^a-z])epl", "eclipse-1[.]0"] },
    { "id": "CPL-1.0", "patterns": ["common public license", "(^|[^a-z])cpl([^a-z]|$)", "cpl1[.]0"] },
    { "id": "MPL-2.0", "patterns": ["mozilla.*2[.]0", "(^|[^a-z])mpl.?2"] },
    { "id": "MPL-1.1", "patterns": ["mozilla", "(^|[^a-z])mpl"] },
    { "id": "LicenseRef-JDOM", "patterns": ["jdom", "acknowledgment clause removed"] },
    { "id": "xpp", "patterns": ["extreme! lab", "indiana university"] },
    { "id": "Apache-1.1", "patterns": ["apache.*1[.]1", "license-1[.]1"] },
    { "id": "Apache-2.0", "patterns": ["apache", "(^|[^a-z])asf([^a-z]|$)", "license-2[.]0"] },
    { "id": "NetCDF", "patterns": ["netcdf"] },
    { "id": "MIT-0", "patterns": ["mit-0", "mit no attribution"] },
    { "id": "MIT", "patterns": ["(^|[^a-z])mit([^a-z]|$)", "mit-license", "licenses/mit", "bouncy ?castle", "bouncycastle", "permission is hereby granted, free of charge"] },
    { "id": "0BSD", "patterns": ["zero-clause bsd", "bsd zero clause", "0bsd"] },
    { "id": "BSD-3-Clause-No-Nuclear-Warranty", "patterns": ["nuclear"] },
    { "id": "BSD-2-Clause", "patterns": ["bsd.?2", "2-clause", "freebsd", "simplified bsd"] },
    { "id": "BSD-3-Clause", "patterns": ["bsd", "ical4j"] },
    { "id": "CC0-1.0", "patterns": ["cc0", "publicdomain/zero"] },
    { "id": "LicenseRef-Public-Domain", "patterns": ["public ?domain"] },
    { "id": "CC-BY-SA-4.0", "patterns": ["by-sa.*4", "sharealike.*4"] },
    { "id": "CC-BY-SA-3.0", "patterns": ["by-sa", "sharealike"] },
    { "id": "CC-BY-4.0", "patterns": ["attribution.*4[.]0", "licenses/by/4"] },
    { "id": "CC-BY-3.0", "patterns": ["attribution.*3[.]0", "licenses/by/3"] },
    { "id": "CC-BY-2.5", "patterns": ["attribution.*2[.]5", "licenses/by/2[.]5"] },
    { "id": "CC-BY", "patterns": ["creative commons attribution", "creativecommons.org/licenses/by/"] },
    { "id": "OFL-1.1", "patterns": ["(^|[^a-z])ofl", "open font license"] },
    { "id": "WTFPL", "patterns": ["wtfpl"] },
    { "id": "Unicode-3.0", "patterns": ["unicode", "(^|[^a-z])icu([^a-z]|$)"] },
    { "id": "W3C", "patterns": ["(^|[^a-z])w3c"] },
    { "id": "BSL-1.0", "patterns": ["boost software"] },
    { "id": "ISC", "patterns": ["(^|[^a-z])isc([^a-z]|$)"] },
    { "id": "Zlib", "patterns": ["zlib"] },
    { "id": "Unlicense", "patterns": ["unlicense"] },
    { "id": "UPL-1.0", "patterns": ["universal permissive"] },
    { "id": "PostgreSQL", "patterns": ["postgresql license"] },
    { "id": "Plexus", "patterns": ["plexus"] },
    { "id": "OGC-1.0", "patterns": ["(^|[^a-z])ogc([^a-z]|$)", "opengeospatial"] }
  ],

  "_aliasSamples": "License texts and the id that the aliases must give. The check fails when one of them gives a different id. Add a sample for each new alias.",
  "aliasSamples": [
    ["The Apache Software License, Version 2.0", "Apache-2.0"],
    ["Apache Software License, Version 1.1", "Apache-1.1"],
    ["Apache License, Version 2.0 with Commons Clause", "LicenseRef-Commons-Clause"],
    ["GNU Lesser General Public License, Version 2.1", "LGPL-2.1"],
