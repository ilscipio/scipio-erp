<entity-engine-xml>
    <!-- SCIPIO: 4.0.0: ACP: expire open checkout sessions and old idempotency keys (hourly), deliver order webhooks (every 5 minutes), product feed (daily 04:10) -->
    <RecurrenceRule recurrenceRuleId="ACP_HOURLY" frequency="HOURLY" intervalNumber="1" countNumber="-1" untilDateTime=""/>
    <RecurrenceInfo recurrenceInfoId="ACP_HOURLY" startDateTime="2026-01-01 00:20:00.000" recurrenceRuleId="ACP_HOURLY" recurrenceCount="0"/>
    <JobSandbox jobId="ACP_EXPIRE" jobName="ACP session expiry" runTime="2026-01-01 00:20:00.000" serviceName="acpExpireSessions"
        poolId="pool" runAsUser="system" recurrenceInfoId="ACP_HOURLY" maxRecurrenceCount="-1" statusId="SERVICE_PENDING"/>
    <RecurrenceRule recurrenceRuleId="ACP_5MIN" frequency="MINUTELY" intervalNumber="5" countNumber="-1" untilDateTime=""/>
    <RecurrenceInfo recurrenceInfoId="ACP_5MIN" startDateTime="2026-01-01 00:00:00.000" recurrenceRuleId="ACP_5MIN" recurrenceCount="0"/>
    <JobSandbox jobId="ACP_WEBHOOKS" jobName="ACP order webhooks" runTime="2026-01-01 00:00:00.000" serviceName="acpDeliverWebhooks"
        poolId="pool" runAsUser="system" recurrenceInfoId="ACP_5MIN" maxRecurrenceCount="-1" statusId="SERVICE_PENDING"/>
    <RecurrenceRule recurrenceRuleId="ACP_DAILY" frequency="DAILY" intervalNumber="1" countNumber="-1" untilDateTime=""/>
    <RecurrenceInfo recurrenceInfoId="ACP_DAILY" startDateTime="2026-01-01 04:10:00.000" recurrenceRuleId="ACP_DAILY" recurrenceCount="0"/>
    <JobSandbox jobId="ACP_FEED" jobName="ACP product feed" runTime="2026-01-01 04:10:00.000" serviceName="acpGenerateFeeds"
        poolId="pool" runAsUser="system" recurrenceInfoId="ACP_DAILY" maxRecurrenceCount="-1" statusId="SERVICE_PENDING"/>
</entity-engine-xml>
