<!--
 All (relative) paths are relative to the installation path
  
  persistent: Save changes made via the API to this file
  sharedLib: path to a lib directory that will be shared across all cores
-->
<solr>
  <!-- SCIPIO: 4.0.0: pooled runtime: one core per store (product_<tenantId>, transient); at most transientCacheSize
       store cores stay open (least recently used closes first); all cores share one schema object -->
  <int name="transientCacheSize">${solr.transientCacheSize:40}</int>
  <bool name="shareSchema">${shareSchema:true}</bool>

  <!--
  adminPath: RequestHandler path to manage cores.  
    If 'null' (or absent), cores will not be manageable via request handler
  -->
  <!-- <cores adminPath="/admin/cores" defaultCoreName="collection1">
