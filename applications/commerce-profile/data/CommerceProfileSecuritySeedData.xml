    <SecurityGroupPermission groupId="TENANT_OWNER" permissionId="ORDERMGR_UPDATE"/>
    <SecurityGroupPermission groupId="TENANT_OWNER" permissionId="ORDERMGR_DELETE"/>
    <SecurityGroupPermission groupId="TENANT_OWNER" permissionId="ORDERMGR_NOTE"/>
    <SecurityGroupPermission groupId="TENANT_OWNER" permissionId="ORDERMGR_RETURN"/>
    <SecurityGroupPermission groupId="TENANT_OWNER" permissionId="ORDERMGR_SEND_CONFIRMATION"/>
    <SecurityGroupPermission groupId="TENANT_OWNER" permissionId="ORDERMGR_SALES_ENTRY"/>
